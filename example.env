# for loader
DATA_TYPE=*.pdf
DATA_PATH=./data/
TOC_PATH=./toc_data/

# for splitter
CHUNK_SIZE=1024
CHUNK_OVERLAP=256
SEPARATORS=["\n\n","\n","."," ",""]

# for encoder
ENCODER_NAME=cl100k_base

# for embedder
EMBEDDER_NAME=BAAI/bge-small-en-v1.5

# for vectorstore
PERSIST_DIRECTORY=./chroma_books_vectorstore
TOC_PERSIST_DIRECTORY=./chroma_toc_vectorstore

# for LLM
GROQ_API_KEY= YOUR API KEY HERE!!!!
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:latest
MAX_TOKENS=20000
OLLAMA_HOST=http://ollama:11434